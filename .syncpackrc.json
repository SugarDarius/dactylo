{
  "$schema": "./node_modules/syncpack/schema.json",
  "versionGroups": [
    {
      "label": "Packages peer deps — broad ranges authorized, not synced with apps",
      "dependencyTypes": ["peer"],
      "isIgnored": true
    },
    {
      "label": "Dev dependencies must use catalog entries only",
      "dependencyTypes": ["dev"],
      "policy": "catalog",
      "severity": {
        "NotUsingCatalog": "error",
        "MissingFromCatalog": "warn"
      }
    }
  ]
}
