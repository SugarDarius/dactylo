{
  "name": "@sugardarius/dactylo",
  "version": "1.0.0-alpha.1",
  "description": "A block-based rich-text markdown editor.",
  "keywords": [
    "block-based",
    "editor",
    "markdown",
    "rich-text"
  ],
  "bugs": {
    "url": "https://github.com/SugarDarius/dactylo/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aurélien Dupays Dexemple",
    "url": "https://aureliendupaysdexemple.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SugarDarius/dactylo",
    "directory": "packages/dactylo"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "module": "./dist/index.js",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "module": "./dist/react/index.js",
        "default": "./dist/react/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.x"
  }
}
